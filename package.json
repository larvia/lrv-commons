    "test": "jest"
  },
  "dependencies": {},
  "devDependencies": {
    "@nestjs/common": "10.4.15",
    "@nestjs/core": "10.4.15",
    "@types/jest": "29.5.12",
    "jest": "29.7.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "ts-jest": "29.2.5",
    "typescript": "5.8.3"
  },
  "peerDependencies": {
    "@nestjs/common": ">=9",
    "@nestjs/core": ">=9"
  },
  "peerDependenciesMeta": {
